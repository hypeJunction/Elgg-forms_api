{
	"name": "hypejunction/forms_api",
	"version": "6.0.0",
	"type": "elgg-plugin",
	"description": "Forms API \u2014 form field rendering helpers for Elgg",
	"homepage": "https://github.com/hypeJunction/Elgg-forms_api",
	"keywords": [
		"elgg",
		"plugin",
		"forms"
	],
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"elgg/elgg": "~6.1.0",
		"ext-intl": "*",
		"composer/installers": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"hypeJunction\\FormsApi\\": "classes/hypeJunction/FormsApi/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"extra": {
		"installer-name": "forms_api",
		"elgg-plugin": {
			"id": "forms_api"
		}
	}
}
