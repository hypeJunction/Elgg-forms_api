{
	"name": "hypejunction/forms_api",
	"version": "4.0.0",
	"type": "elgg-plugin",
	"description": "Forms API \u2014 form field rendering helpers for Elgg",
	"homepage": "http://hypejunction.com",
	"keywords": [
		"elgg",
		"plugin",
		"forms"
	],
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Ismayil Khayredinov",
			"email": "info@hypejunction.com"
		}
	],
	"require": {
		"php": ">=7.4",
		"elgg/elgg": "^4.0",
		"composer/installers": "^2.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"hypeJunction\\FormsApi\\": "classes/hypeJunction/FormsApi/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"extra": {
		"installer-name": "forms_api",
		"elgg-plugin": {
			"id": "forms_api"
		}
	}
}
